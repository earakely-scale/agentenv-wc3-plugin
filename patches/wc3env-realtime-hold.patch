+/* A realtime game created with hold stands at its start, as a stepping game between steps, until release lets
+ * its clock run: every player can look and send its first orders (queued for the first frame) before any time
+ * passes. */
+static void release_job(void *a) {
+    (void)a;
+    g_realtime_held = 0;
+    step_mode(0);
+}
+static void m_release(JW *w, LONGLONG id) {
+    if (g_status != ST_IN_GAME) {
+        reply_error(w, id, "bad_status", STATUS_ERR("release"));
+        return;
+    }
+    if (!g_realtime_held) {
+        reply_error(w, id, "bad_status", "release starts a realtime game created with hold, once");
+        return;
+    }
+    if (!run_on_game_thread(release_job, NULL, 5000)) {
+        reply_error(w, id, "bad_status", "the game thread did not answer");
+        return;
+    }
+    reply_head(w, id, 1);
+    jw_key(w, "result");
+    jw_open(w, '{');
+    jw_key(w, "game_time_ms");
+    jw_uint(w, game_time());
+    jw_close(w, '}');
+    jw_close(w, '}');
+}
