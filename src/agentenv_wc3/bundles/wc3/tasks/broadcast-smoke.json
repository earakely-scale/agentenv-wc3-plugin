[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent-red",
    "type": "deploy_agent",
    "agent_name": "red",
    "a2a_agent_id": "wc3-scripted",
    "env_ids": [],
    "env_vars": {
      "SCRIPT": "attack"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "agent-blue",
    "type": "deploy_agent",
    "agent_name": "blue",
    "a2a_agent_id": "wc3-scripted",
    "env_ids": [],
    "env_vars": {
      "SCRIPT": "raid",
      "SCRIPT_AFTER_SECONDS": "30"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "license",
    "type": "add_license",
    "env_id": "wc3",
    "files": {
      "roc.w3k": "WC3_ROC_W3K",
      "tft.w3k": "WC3_TFT_W3K"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "open_lobby",
    "env_id": "wc3",
    "game_settings": {
      "map": "(2)EchoIsles.w3x",
      "seed": 3,
      "time_limit_seconds": 120,
      "mode": "stepping",
      "client_view": true
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-red",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "0",
    "player_kind": "agent",
    "player_name": "red",
    "game_settings": {
      "faction": "human",
      "label": "Red",
      "omniscient": true
    },
    "depends_on": [
      "match",
      "agent-red"
    ]
  },
  {
    "id": "slot-blue",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "1",
    "player_kind": "agent",
    "player_name": "blue",
    "game_settings": {
      "faction": "orc",
      "label": "Blue",
      "omniscient": true
    },
    "depends_on": [
      "match",
      "agent-blue"
    ]
  },
  {
    "id": "start",
    "type": "close_lobby",
    "env_id": "wc3",
    "depends_on": [
      "slot-red",
      "slot-blue",
      "license"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "ops": [
            {
              "op": "spawn",
              "player": "red",
              "type": "hfoo",
              "n": 4,
              "at": "toward:enemy_home:3000",
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "blue",
              "type": "ogru",
              "n": 3,
              "at": "toward:enemy_home:2600",
              "as": "enemy"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "broadcast",
    "type": "start_broadcast",
    "env_id": "wc3",
    "title": "Broadcast smoke",
    "overlay": [
      {
        "widget": "score_bug"
      },
      {
        "widget": "page",
        "url": "env:/live?panel",
        "box": [
          1500,
          100,
          396,
          800
        ]
      },
      {
        "widget": "end_card"
      }
    ],
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "play-red",
    "type": "prompt_agent",
    "agent_name": "red",
    "prompt_id": "broadcast-smoke-red",
    "prompt": "Play with the script.",
    "timeout_seconds": 900,
    "depends_on": [
      "stage",
      "broadcast"
    ]
  },
  {
    "id": "play-blue",
    "type": "prompt_agent",
    "agent_name": "blue",
    "prompt_id": "broadcast-smoke-blue",
    "prompt": "Play with the script.",
    "timeout_seconds": 900,
    "depends_on": [
      "stage",
      "broadcast"
    ]
  },
  {
    "id": "finish",
    "type": "finish_match",
    "env_id": "wc3",
    "depends_on": [
      "play-red",
      "play-blue"
    ]
  },
  {
    "id": "save-broadcast",
    "type": "save_broadcast",
    "env_id": "wc3",
    "broadcast": "broadcast",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "rubric": "dense",
    "verifier_id": "broadcast-smoke",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "files",
    "type": "save_match_files",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
