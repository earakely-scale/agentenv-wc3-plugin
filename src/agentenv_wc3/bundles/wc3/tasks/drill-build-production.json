[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "license",
    "type": "add_license",
    "env_id": "wc3",
    "files": {
      "roc.w3k": "WC3_ROC_W3K",
      "tft.w3k": "WC3_TFT_W3K"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "open_lobby",
    "env_id": "wc3",
    "game_settings": {
      "map": "(2)EchoIsles.w3x",
      "seed": 1,
      "time_limit_seconds": 240,
      "mode": "stepping"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "0",
    "player_kind": "agent",
    "player_name": "wc3",
    "game_settings": {
      "faction": "human"
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-ai",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "1",
    "player_kind": "ai",
    "game_settings": {
      "faction": "orc",
      "ai_level": "easy"
    },
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "start",
    "type": "close_lobby",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-ai",
      "license"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "resources",
              "player": "wc3",
              "gold": 1500,
              "lumber": 800
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hbar",
              "at": "home",
              "dx": 600,
              "dy": -600,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hhou",
              "at": "home",
              "dx": -500,
              "dy": -500,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hhou",
              "at": "home",
              "dx": -700,
              "dy": -500,
              "as": "base"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-build-production",
    "prompt": "You have a Barracks, two Farms and a big bank. Grow production: build a second Barracks and a Blacksmith, keep both Barracks training Footmen (and Riflemen once the Blacksmith stands) without pause, keep Peasants mining and building Farms ahead of the food cap, and do not sit on gold.",
    "timeout_seconds": 2880,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "finish",
    "type": "finish_match",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "player_names": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "count:hbar",
        "op": ">=",
        "value": 2
      },
      {
        "metric": "first_time:hbla",
        "op": "<=",
        "value": 130
      },
      {
        "metric": "units_trained",
        "op": ">=",
        "value": 8
      },
      {
        "metric": "supply_blocked_seconds",
        "op": "<=",
        "value": 15
      },
      {
        "metric": "average_unspent_gold",
        "op": "<=",
        "value": 500
      },
      {
        "metric": "idle_worker_seconds",
        "op": "<=",
        "value": 30
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "files",
    "type": "save_match_files",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
