[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "license",
    "type": "add_license",
    "env_id": "wc3",
    "files": {
      "roc.w3k": "WC3_ROC_W3K",
      "tft.w3k": "WC3_TFT_W3K"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "open_lobby",
    "env_id": "wc3",
    "game_settings": {
      "map": "(2)EchoIsles.w3x",
      "seed": 1,
      "time_limit_seconds": 300,
      "mode": "stepping"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "0",
    "player_kind": "agent",
    "player_name": "wc3",
    "game_settings": {
      "faction": "human",
      "team": 1
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-ai",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "1",
    "player_kind": "ai",
    "game_settings": {
      "faction": "orc",
      "team": 2,
      "ai_level": "easy"
    },
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "start",
    "type": "close_lobby",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-ai",
      "license"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "macro-micro-quick",
    "prompt": "Play the game the env has started to its end.",
    "timeout_seconds": 3600,
    "depends_on": [
      "start",
      "agent"
    ],
    "fail_task_on_error": false
  },
  {
    "id": "finish",
    "type": "finish_match",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "rubric": "outcome",
    "verifier_id": "wc3",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "files",
    "type": "save_match_files",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
