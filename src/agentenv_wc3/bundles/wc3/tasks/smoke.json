[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "license",
    "type": "add_license",
    "env_id": "wc3",
    "files": {
      "roc.w3k": "WC3_ROC_W3K",
      "tft.w3k": "WC3_TFT_W3K"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "create_match",
    "env_id": "wc3",
    "additional_settings": {
      "map": "(2)EchoIsles.w3x",
      "seed": 1,
      "time_limit_seconds": 120
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-player",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "agent",
      "name": "player"
    },
    "slot": 0,
    "additional_settings": {
      "faction": "human",
      "team": 1
    },
    "depends_on": [
      "match"
    ],
    "register": false
  },
  {
    "id": "slot-ai",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "ai"
    },
    "slot": 1,
    "additional_settings": {
      "faction": "orc",
      "team": 2,
      "ai_level": "normal"
    },
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "start",
    "type": "start_match",
    "env_id": "wc3",
    "depends_on": [
      "slot-player",
      "slot-ai",
      "license"
    ]
  },
  {
    "id": "idle",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:idle/v1",
        "args": {
          "seconds": 120
        }
      }
    ],
    "depends_on": [
      "deploy",
      "start"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "rubric": "smoke",
    "verifier_id": "smoke",
    "depends_on": [
      "idle"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
