[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "seat",
    "type": "rts_seat_agents",
    "env_id": "wc3",
    "agents": [
      "wc3"
    ],
    "depends_on": [
      "agent"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 180,
    "mode": "stepping",
    "seats": [
      {
        "agent": "wc3",
        "race": "human"
      },
      {
        "computer": "easy",
        "race": "orc"
      }
    ],
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "resources",
              "player": "wc3",
              "gold": 1500,
              "lumber": 500
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "halt",
              "at": "home",
              "dx": -700,
              "dy": 600,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "Hamg",
              "at": "toward:enemy_home:3000",
              "as": "hero"
            },
            {
              "op": "level",
              "unit": "hero",
              "level": 2
            },
            {
              "op": "hp",
              "unit": "hero",
              "value": 5
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "ogru",
              "n": 4,
              "at": "toward:enemy_home:3000",
              "as": "enemy"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-hero-revive",
    "prompt": "Your Archmage is caught alone by Grunts far from base and will die. Your Altar of Kings stands at home and you have gold. Get the Archmage back into play.",
    "timeout_seconds": 2160,
    "depends_on": [
      "stage",
      "seat"
    ]
  },
  {
    "id": "finish",
    "type": "rts_finish",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "hero_alive",
        "op": "==",
        "value": true
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
