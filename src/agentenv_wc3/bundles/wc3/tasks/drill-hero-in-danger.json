[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "opponent",
    "type": "deploy_agent",
    "agent_name": "opponent",
    "a2a_agent_id": "wc3-scripted",
    "env_ids": [],
    "env_vars": {
      "SCRIPT": "attack",
      "SCRIPT_AFTER_SECONDS": "0",
      "SCRIPT_EVERY_SECONDS": "5"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "seat",
    "type": "rts_seat_agents",
    "env_id": "wc3",
    "agents": [
      "wc3",
      "opponent"
    ],
    "depends_on": [
      "agent",
      "opponent"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 90,
    "mode": "stepping",
    "seats": [
      {
        "agent": "wc3",
        "race": "human"
      },
      {
        "agent": "opponent",
        "race": "orc",
        "omniscient": true
      }
    ],
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "spawn",
              "player": "wc3",
              "type": "Hamg",
              "at": "toward:enemy_home:6000",
              "as": "hero"
            },
            {
              "op": "level",
              "unit": "hero",
              "level": 3
            },
            {
              "op": "give",
              "unit": "hero",
              "type": "phea"
            },
            {
              "op": "give",
              "unit": "hero",
              "type": "stwp"
            },
            {
              "op": "hp",
              "unit": "hero",
              "value": 180
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hfoo",
              "n": 2,
              "at": "toward:enemy_home:6000",
              "dx": 120,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "ogru",
              "n": 4,
              "at": "toward:enemy_home:5600",
              "as": "enemy"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-hero-in-danger",
    "prompt": "Your hero is badly hurt, carries a Potion of Healing and a Scroll of Town Portal, has unspent skill points, and enemies are on top of it with only two Footmen to help. Keep the hero alive.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage",
      "seat"
    ]
  },
  {
    "id": "play-opponent",
    "type": "prompt_agent",
    "agent_name": "opponent",
    "prompt_id": "drill-hero-in-danger-opponent",
    "prompt": "Play your seat with the script.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage",
      "seat"
    ]
  },
  {
    "id": "finish",
    "type": "rts_finish",
    "env_id": "wc3",
    "depends_on": [
      "play",
      "play-opponent"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "hero_alive",
        "op": "==",
        "value": true
      },
      {
        "metric": "items_used",
        "op": ">=",
        "value": 1
      },
      {
        "metric": "unspent_skill_points",
        "op": "<=",
        "value": 0
      },
      {
        "metric": "hero_health_percent",
        "op": ">=",
        "value": 40
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
