[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "opponent",
    "type": "deploy_agent",
    "agent_name": "opponent",
    "a2a_agent_id": "wc3-scripted",
    "env_ids": [],
    "env_vars": {
      "SCRIPT": "raid",
      "SCRIPT_AFTER_SECONDS": "150",
      "SCRIPT_EVERY_SECONDS": "5"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "seat",
    "type": "rts_seat_agents",
    "env_id": "wc3",
    "agents": [
      "wc3",
      "opponent"
    ],
    "depends_on": [
      "agent",
      "opponent"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 270,
    "mode": "stepping",
    "seats": [
      {
        "agent": "wc3",
        "race": "human"
      },
      {
        "agent": "opponent",
        "race": "orc",
        "omniscient": true
      }
    ],
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "resources",
              "player": "wc3",
              "gold": 1000,
              "lumber": 600
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hfoo",
              "n": 2,
              "at": "home",
              "dx": 300,
              "dy": -500,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "ogru",
              "n": 3,
              "at": "toward:enemy_home:7500",
              "dx": 0,
              "dy": 0,
              "as": "enemy"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-build-towers",
    "prompt": "Three Grunts will raid your Peasants in about two and a half minutes; you have two Footmen. Get towers up in time: a Guard Tower needs a Lumber Mill, so build the Lumber Mill at once, then two Scout Towers between the Gold Mine and the Town Hall (build #peasant Scout Tower near the gold mine), and upgrade each to a Guard Tower as soon as the mill stands (upgrade #tower Guard Tower). Keep the other Peasants mining. When the raid comes, cast Call to Arms at the Town Hall and fight under the towers.",
    "timeout_seconds": 3240,
    "depends_on": [
      "stage",
      "seat"
    ]
  },
  {
    "id": "play-opponent",
    "type": "prompt_agent",
    "agent_name": "opponent",
    "prompt_id": "drill-build-towers-opponent",
    "prompt": "Play your seat with the script.",
    "timeout_seconds": 3240,
    "depends_on": [
      "stage",
      "seat"
    ]
  },
  {
    "id": "finish",
    "type": "rts_finish",
    "env_id": "wc3",
    "depends_on": [
      "play",
      "play-opponent"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "first_time:hgtw",
        "op": "<=",
        "value": 170
      },
      {
        "metric": "count:hgtw",
        "op": ">=",
        "value": 2
      },
      {
        "metric": "enemy_army_destroyed_percent",
        "op": ">=",
        "value": 100
      },
      {
        "metric": "workers_lost",
        "op": "<=",
        "value": 2
      },
      {
        "metric": "structures_lost",
        "op": "<=",
        "value": 0
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
