[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "opponent",
    "type": "deploy_agent",
    "agent_name": "opponent",
    "a2a_agent_id": "wc3-scripted",
    "env_ids": [],
    "env_vars": {
      "SCRIPT": "raid",
      "SCRIPT_AFTER_SECONDS": "0",
      "SCRIPT_EVERY_SECONDS": "5"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "license",
    "type": "add_license",
    "env_id": "wc3",
    "files": {
      "roc.w3k": "WC3_ROC_W3K",
      "tft.w3k": "WC3_TFT_W3K"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "open_lobby",
    "env_id": "wc3",
    "game_settings": {
      "map": "(2)EchoIsles.w3x",
      "seed": 1,
      "time_limit_seconds": 150,
      "mode": "stepping"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "0",
    "player_kind": "agent",
    "player_name": "wc3",
    "game_settings": {
      "faction": "night_elf"
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-opponent",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "1",
    "player_kind": "agent",
    "player_name": "opponent",
    "game_settings": {
      "faction": "orc",
      "omniscient": true
    },
    "depends_on": [
      "match",
      "opponent"
    ]
  },
  {
    "id": "start",
    "type": "close_lobby",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-opponent",
      "license"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "spawn",
              "player": "wc3",
              "type": "eaom",
              "at": "home",
              "dx": 500,
              "dy": -500,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "emow",
              "at": "home",
              "dx": -500,
              "dy": -500,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "etrp",
              "at": "home",
              "dx": 0,
              "dy": -800,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "earc",
              "n": 3,
              "at": "home",
              "dx": -1400,
              "dy": -900,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "hfoo",
              "n": 3,
              "at": "home",
              "dx": 800,
              "dy": 300,
              "as": "enemy"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "hrif",
              "at": "home",
              "dx": 900,
              "dy": 300,
              "as": "enemy"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-defend-base-nightelf",
    "prompt": "Three Footmen and a Rifleman are raiding your Wisps; three Archers are across the base. Wisps cannot fight: move them behind the Tree of Life. Your buildings can fight: cast Uproot at the Ancient of War so it walks and attacks (cast Root when it is over), the Ancient Protector shoots on its own, and the Moon Well heals a hurt unit standing next to it (cast Replenish Mana and Life at the Moon Well on the unit). Bring the Archers back and fight beside the Ancient Protector and the Moon Well.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "play-opponent",
    "type": "prompt_agent",
    "agent_name": "opponent",
    "prompt_id": "drill-defend-base-nightelf-opponent",
    "prompt": "Play your seat with the script.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "finish",
    "type": "finish_match",
    "env_id": "wc3",
    "depends_on": [
      "play",
      "play-opponent"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "enemy_army_destroyed_percent",
        "op": ">=",
        "value": 100
      },
      {
        "metric": "uprooted_seconds",
        "op": ">=",
        "value": 10
      },
      {
        "metric": "workers_lost",
        "op": "<=",
        "value": 1
      },
      {
        "metric": "structures_lost",
        "op": "<=",
        "value": 0
      },
      {
        "metric": "units_lost",
        "op": "<=",
        "value": 1
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
