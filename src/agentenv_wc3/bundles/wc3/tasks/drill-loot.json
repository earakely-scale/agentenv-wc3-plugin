[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 90,
    "mode": "stepping",
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "agent",
      "name": "wc3"
    },
    "slot": 0,
    "additional_settings": {
      "faction": "human"
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-ai",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "ai"
    },
    "slot": 1,
    "additional_settings": {
      "faction": "orc",
      "ai_level": "easy"
    },
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "start",
    "type": "start_match",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-ai"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "Hamg",
              "at": "home",
              "dx": -900,
              "dy": -700,
              "as": "hero"
            },
            {
              "op": "level",
              "unit": "hero",
              "level": 2
            },
            {
              "op": "item",
              "type": "tint",
              "at": "home",
              "dx": -1200,
              "dy": -700
            },
            {
              "op": "item",
              "type": "rat6",
              "at": "home",
              "dx": -900,
              "dy": -1000
            },
            {
              "op": "item",
              "type": "phea",
              "at": "home",
              "dx": -600,
              "dy": -800
            },
            {
              "op": "item",
              "type": "tstr",
              "at": "home",
              "dx": -1000,
              "dy": -400
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-loot",
    "prompt": "Four items lie on the ground around your hero and nothing threatens it. Pick all of them up.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "finish",
    "type": "rts_finish",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "items_picked_up",
        "op": ">=",
        "value": 4
      },
      {
        "metric": "items_carried",
        "op": ">=",
        "value": 2
      },
      {
        "metric": "unspent_skill_points",
        "op": "<=",
        "value": 0
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
