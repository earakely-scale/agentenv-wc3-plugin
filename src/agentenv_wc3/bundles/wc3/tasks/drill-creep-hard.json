        "op": "<=",
        "value": 2
      },
      {
        "metric": "hero_alive",
        "op": "==",
        "value": true
      },
      {
        "metric": "army_kept_percent",
        "op": ">=",
        "value": 60
      },
      {
        "metric": "items_picked_up",
        "op": ">=",
        "value": 1
      },
      {
        "metric": "unspent_skill_points",
        "op": "<=",
        "value": 0
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "files",
    "type": "save_match_files",
    "env_id": "wc3",
