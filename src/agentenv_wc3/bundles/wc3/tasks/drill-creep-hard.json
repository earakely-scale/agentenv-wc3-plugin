  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "Hamg",
              "at": "toward:camp:9:900",
              "dx": 0,
              "as": "hero"
            },
            {
              "op": "level",
              "unit": "hero",
              "level": 3
            },
            {
              "op": "give",
              "unit": "hero",
              "type": "phea"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hfoo",
              "n": 5,
              "at": "toward:camp:9:900",
              "dx": 150,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hrif",
              "n": 3,
              "at": "toward:camp:9:900",
              "dx": -150,
              "as": "army"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-creep-hard",
    "prompt": "A level 3 Archmage, five Footmen and three Riflemen stand next to a strong camp. Clear it with few losses: focus targets, keep the hero alive, pull badly hurt units back, use the potion if needed, take the drops.\n\nGame time is frozen until you call advance, so think as long as you like. The loop: get_state shows your resources, units, structures, idle workers and what happened; act queues orders for your units by id; advance sends them and lets 1-60 game seconds pass (a few seconds in fights, longer while the economy runs). list_units shows ids, positions and orders; list_units with details=true shows what a unit can train, build, research and cast; resources lists gold mines and trees; lookup gives any type's cost, requirements and stats. Coordinates are the game's world units: copy them from the tools' output. Types can be given by name: train {\"type_id\": \"Peasant\"}, build {\"type_id\": \"Farm\", \"x\": ..., \"y\": ..., \"auto_place\": true}. When the game refuses an order, advance says why; don't repeat it unchanged.\n\nYou act only through the wc3 tools; nobody will answer questions, so never ask or wait for confirmation. Keep playing until advance reports GAME OVER, then reply with the result.",
    "timeout_seconds": 2520,
    "depends_on": [
      "stage"
    ],
    "fail_task_on_error": false
  },
  {
    "id": "finish",
    "type": "finish_match",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "player_names": [
      "wc3"
    ],
    "rubric": "checks",
