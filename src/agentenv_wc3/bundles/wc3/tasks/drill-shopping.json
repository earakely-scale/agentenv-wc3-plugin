[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 580,
    "mode": "stepping",
    "seats": [
      {
        "agent": "wc3",
        "race": "human"
      },
      {
        "computer": "easy",
        "race": "orc"
      }
    ],
    "depends_on": [
      "agent"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 460,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "resources",
              "player": "wc3",
              "gold": 1000,
              "lumber": 0
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hkee",
              "at": "home",
              "dx": -1400,
              "dy": -900,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hvlt",
              "at": "home",
              "dx": -900,
              "dy": -600,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "Hmkg",
              "at": "home",
              "dx": -750,
              "dy": -600,
              "as": "hero"
            },
            {
              "op": "level",
              "unit": "hero",
              "level": 2
            }
          ]
        }
      }
    ],
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-shopping",
    "prompt": "Your hero stands next to your Arcane Vault with 1000 gold; you own a Keep and the Vault has just received its first stock. Buy three useful items from it.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "items_bought",
        "op": ">=",
        "value": 3
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
