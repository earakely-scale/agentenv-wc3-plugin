[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-llm",
    "env_ids": [],
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "license",
    "type": "add_license",
    "env_id": "wc3",
    "files": {
      "roc.w3k": "WC3_ROC_W3K",
      "tft.w3k": "WC3_TFT_W3K"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "open_lobby",
    "env_id": "wc3",
    "game_settings": {
      "map": "(2)EchoIsles.w3x",
      "seed": 1,
      "time_limit_seconds": 150,
      "mode": "stepping"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "0",
    "player_kind": "agent",
    "player_name": "wc3",
    "game_settings": {
      "faction": "human"
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-ai",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "1",
    "player_kind": "ai",
    "game_settings": {
      "faction": "orc",
      "ai_level": "easy"
    },
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "start",
    "type": "close_lobby",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-ai",
      "license"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "Hamg",
              "at": "toward:nearest_camp:900",
              "as": "hero"
            },
            {
              "op": "level",
              "unit": "hero",
              "level": 1
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hfoo",
              "n": 4,
              "at": "toward:nearest_camp:900",
              "dx": 150,
              "as": "army"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-creep-easy",
    "prompt": "Your Archmage and four Footmen stand next to the nearest creep camp. Clear it quickly, lose nobody, keep the hero healthy, spend the hero's skill point, and pick up whatever the creeps drop.\n\nGame time is frozen until you call advance, so think as long as you like. The loop: get_state shows your resources, units, structures, idle workers and what happened; act queues orders for your units by id; advance sends them and lets 1-60 game seconds pass (a few seconds in fights, longer while the economy runs). list_units shows ids, positions and orders; list_units with details=true shows what a unit can train, build, research and cast; resources lists gold mines and trees; lookup gives any type's cost, requirements and stats. Coordinates are the game's world units: copy them from the tools' output. Types can be given by name: train {\"type_id\": \"Peasant\"}, build {\"type_id\": \"Farm\", \"x\": ..., \"y\": ..., \"auto_place\": true}. When the game refuses an order, advance says why; don't repeat it unchanged.\n\nYou act only through the wc3 tools; nobody will answer questions, so never ask or wait for confirmation. Keep playing until advance reports GAME OVER, then reply with the result.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ],
    "fail_task_on_error": false
  },
  {
    "id": "finish",
    "type": "finish_match",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "player_names": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "camp_cleared",
        "op": "==",
        "value": true
      },
      {
        "metric": "camp_cleared_time",
        "op": "<=",
        "value": 90
      },
      {
        "metric": "units_lost",
        "op": "<=",
        "value": 0
      },
      {
        "metric": "hero_health_percent",
        "op": ">=",
        "value": 60
      },
      {
        "metric": "unspent_skill_points",
        "op": "<=",
        "value": 0
      },
      {
        "metric": "items_picked_up",
        "op": ">=",
        "value": 1
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "files",
    "type": "save_match_files",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
