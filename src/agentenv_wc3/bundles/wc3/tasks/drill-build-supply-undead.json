[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 180,
    "mode": "stepping",
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "agent",
      "name": "wc3"
    },
    "slot": 0,
    "additional_settings": {
      "faction": "undead"
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-ai",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "ai"
    },
    "slot": 1,
    "additional_settings": {
      "faction": "orc",
      "ai_level": "easy"
    },
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "start",
    "type": "start_match",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-ai"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "resources",
              "player": "wc3",
              "gold": 600,
              "lumber": 500
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "ugho",
              "n": 2,
              "at": "home",
              "dx": 300,
              "dy": -500,
              "as": "army"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-build-supply-undead",
    "prompt": "You are almost at the food cap with money in the bank. Build Ziggurats right away, at least three, so production never stops: keep the hall training workers the whole time and never get supply blocked. Send workers to gold and lumber first.",
    "timeout_seconds": 2160,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "finish",
    "type": "rts_finish",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "count:uzig",
        "op": ">=",
        "value": 3
      },
      {
        "metric": "supply_blocked_seconds",
        "op": "<=",
        "value": 60
      },
      {
        "metric": "workers",
        "op": ">=",
        "value": 7
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
