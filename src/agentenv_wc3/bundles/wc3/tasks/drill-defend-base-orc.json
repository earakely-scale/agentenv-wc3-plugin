[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-llm",
    "env_ids": [],
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "opponent",
    "type": "deploy_agent",
    "agent_name": "opponent",
    "a2a_agent_id": "wc3-scripted",
    "env_ids": [],
    "env_vars": {
      "SCRIPT": "raid",
      "SCRIPT_AFTER_SECONDS": "0",
      "SCRIPT_EVERY_SECONDS": "5"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "license",
    "type": "add_license",
    "env_id": "wc3",
    "files": {
      "roc.w3k": "WC3_ROC_W3K",
      "tft.w3k": "WC3_TFT_W3K"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "open_lobby",
    "env_id": "wc3",
    "game_settings": {
      "map": "(2)EchoIsles.w3x",
      "seed": 1,
      "time_limit_seconds": 150,
      "mode": "stepping"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "0",
    "player_kind": "agent",
    "player_name": "wc3",
    "game_settings": {
      "faction": "orc"
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-opponent",
    "type": "add_player_slot",
    "env_id": "wc3",
    "player_id": "1",
    "player_kind": "agent",
    "player_name": "opponent",
    "game_settings": {
      "faction": "orc",
      "omniscient": true
    },
    "depends_on": [
      "match",
      "opponent"
    ]
  },
  {
    "id": "start",
    "type": "close_lobby",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-opponent",
      "license"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "spawn",
              "player": "wc3",
              "type": "otrb",
              "at": "home",
              "dx": 500,
              "dy": -500,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "otrb",
              "at": "home",
              "dx": -500,
              "dy": -500,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "ogru",
              "n": 2,
              "at": "home",
              "dx": -1400,
              "dy": -900,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "hfoo",
              "n": 3,
              "at": "home",
              "dx": 800,
              "dy": 300,
              "as": "enemy"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "hrif",
              "at": "home",
              "dx": 900,
              "dy": 300,
              "as": "enemy"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-defend-base-orc",
    "prompt": "Three Footmen and a Rifleman are raiding your Peons; two Grunts are across the base. Peons cannot fight but Burrows can: cast Battle Stations at each Burrow (or cast #peon Burrow on #burrow) so the Peons garrison and the Burrows shoot, bring the Grunts back and fight under the Burrows. Once the raiders are dead cast Stand Down at each Burrow so the Peons go back to work.\n\nGame time is frozen until you call advance, so think as long as you like. The loop: get_state shows your resources, units, structures, idle workers and what happened; act queues orders for your units by id; advance sends them and lets 1-60 game seconds pass (a few seconds in fights, longer while the economy runs). list_units shows ids, positions and orders; list_units with details=true shows what a unit can train, build, research and cast; resources lists gold mines and trees; lookup gives any type's cost, requirements and stats. Coordinates are the game's world units: copy them from the tools' output. Types can be given by name: train {\"type_id\": \"Peon\"}, build {\"type_id\": \"Orc Burrow\", \"x\": ..., \"y\": ..., \"auto_place\": true}. When the game refuses an order, advance says why; don't repeat it unchanged.\n\nYou act only through the wc3 tools; nobody will answer questions, so never ask or wait for confirmation. Keep playing until advance reports GAME OVER, then reply with the result.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ],
    "fail_task_on_error": false
  },
  {
    "id": "play-opponent",
    "type": "prompt_agent",
    "agent_name": "opponent",
    "prompt_id": "drill-defend-base-orc-opponent",
    "prompt": "Play with the script.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "finish",
    "type": "finish_match",
    "env_id": "wc3",
    "depends_on": [
      "play",
      "play-opponent"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "player_names": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "enemy_army_destroyed_percent",
        "op": ">=",
        "value": 100
      },
      {
        "metric": "fewest_workers",
        "op": "<=",
        "value": 1
      },
      {
        "metric": "workers_lost",
        "op": "<=",
        "value": 1
      },
      {
        "metric": "structures_lost",
        "op": "<=",
        "value": 0
      },
      {
        "metric": "workers",
        "op": ">=",
        "value": 4
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "files",
    "type": "save_match_files",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
