[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "opponent",
    "type": "deploy_agent",
    "agent_name": "opponent",
    "a2a_agent_id": "wc3-scripted",
    "env_ids": [],
    "env_vars": {
      "SCRIPT": "raid",
      "SCRIPT_AFTER_SECONDS": "0",
      "SCRIPT_EVERY_SECONDS": "5"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 150,
    "mode": "stepping",
    "seats": [
      {
        "agent": "wc3",
        "race": "orc"
      },
      {
        "agent": "opponent",
        "race": "orc",
        "omniscient": true
      }
    ],
    "depends_on": [
      "agent",
      "opponent"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "spawn",
              "player": "wc3",
              "type": "otrb",
              "at": "home",
              "dx": 500,
              "dy": -500,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "otrb",
              "at": "home",
              "dx": -500,
              "dy": -500,
              "as": "base"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "ogru",
              "n": 2,
              "at": "home",
              "dx": -1400,
              "dy": -900,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "hfoo",
              "n": 3,
              "at": "home",
              "dx": 800,
              "dy": 300,
              "as": "enemy"
            },
            {
              "op": "spawn",
              "player": "opponent",
              "type": "hrif",
              "at": "home",
              "dx": 900,
              "dy": 300,
              "as": "enemy"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-defend-base-orc",
    "prompt": "Three Footmen and a Rifleman are raiding your Peons; two Grunts are across the base. Peons cannot fight but Burrows can: cast Battle Stations at each Burrow (or cast #peon Burrow on #burrow) so the Peons garrison and the Burrows shoot, bring the Grunts back and fight under the Burrows. Once the raiders are dead cast Stand Down at each Burrow so the Peons go back to work.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "play-opponent",
    "type": "prompt_agent",
    "agent_name": "opponent",
    "prompt_id": "drill-defend-base-orc-opponent",
    "prompt": "Play your seat with the script.",
    "timeout_seconds": 1800,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "enemy_army_destroyed_percent",
        "op": ">=",
        "value": 100
      },
      {
        "metric": "fewest_workers",
        "op": "<=",
        "value": 1
      },
      {
        "metric": "workers_lost",
        "op": "<=",
        "value": 1
      },
      {
        "metric": "structures_lost",
        "op": "<=",
        "value": 0
      },
      {
        "metric": "workers",
        "op": ">=",
        "value": 4
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
