[
  {
    "id": "deploy",
    "type": "deploy_env",
    "env_id": "wc3"
  },
  {
    "id": "agent",
    "type": "deploy_agent",
    "agent_name": "wc3",
    "a2a_agent_id": "wc3-macro-micro",
    "env_ids": [],
    "env_vars": {
      "WC3_MICRO_MODEL": "anthropic/claude-haiku-4-5",
      "WC3_GOAL": "prompt"
    },
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "match",
    "type": "wc3_match",
    "env_id": "wc3",
    "map": "(2)EchoIsles.w3x",
    "seed": 1,
    "time_limit_seconds": 240,
    "mode": "stepping",
    "depends_on": [
      "deploy"
    ]
  },
  {
    "id": "slot-wc3",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "agent",
      "name": "wc3"
    },
    "slot": 0,
    "additional_settings": {
      "faction": "human"
    },
    "depends_on": [
      "match",
      "agent"
    ]
  },
  {
    "id": "slot-ai",
    "type": "add_player_slot",
    "env_id": "wc3",
    "occupant": {
      "kind": "ai"
    },
    "slot": 1,
    "additional_settings": {
      "faction": "orc",
      "ai_level": "easy"
    },
    "depends_on": [
      "match"
    ]
  },
  {
    "id": "start",
    "type": "start_match",
    "env_id": "wc3",
    "depends_on": [
      "slot-wc3",
      "slot-ai"
    ]
  },
  {
    "id": "stage",
    "type": "apply_server_config",
    "env_id": "wc3",
    "timeout_seconds": 600,
    "directives": [
      {
        "service": "wc3",
        "uri": "urn:wc3:stage/v1",
        "args": {
          "warmup_seconds": 0,
          "ops": [
            {
              "op": "ai",
              "player": "opponent",
              "paused": true
            },
            {
              "op": "resources",
              "player": "wc3",
              "gold": 3000,
              "lumber": 1500
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hbar",
              "at": "home",
              "dx": -700,
              "dy": -500,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hbla",
              "at": "home",
              "dx": -700,
              "dy": 100,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "halt",
              "at": "home",
              "dx": -100,
              "dy": -800,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hhou",
              "n": 3,
              "at": "home",
              "dx": 500,
              "dy": -800,
              "as": "army"
            },
            {
              "op": "spawn",
              "player": "wc3",
              "type": "hpea",
              "n": 5,
              "at": "home",
              "dx": 200,
              "dy": 300,
              "as": "army"
            }
          ]
        }
      }
    ],
    "depends_on": [
      "start"
    ]
  },
  {
    "id": "play",
    "type": "prompt_agent",
    "agent_name": "wc3",
    "model": "anthropic/claude-haiku-4-5",
    "prompt_id": "drill-spend-and-tech",
    "prompt": "You start rich with a developed base. Spend it well: keep production buildings busy, start the Keep upgrade early, research upgrades, never sit on unspent gold, never get supply blocked.",
    "timeout_seconds": 2880,
    "depends_on": [
      "stage"
    ]
  },
  {
    "id": "finish",
    "type": "rts_finish",
    "env_id": "wc3",
    "depends_on": [
      "play"
    ]
  },
  {
    "id": "grade",
    "type": "rts_grade",
    "env_id": "wc3",
    "seats": [
      "wc3"
    ],
    "rubric": "checks",
    "checks": [
      {
        "metric": "upgrade_started_time",
        "op": "<=",
        "value": 40
      },
      {
        "metric": "units_trained",
        "op": ">=",
        "value": 12
      },
      {
        "metric": "researches_done",
        "op": ">=",
        "value": 2
      },
      {
        "metric": "average_unspent_gold",
        "op": "<=",
        "value": 1200
      },
      {
        "metric": "supply_blocked_seconds",
        "op": "<=",
        "value": 20
      },
      {
        "metric": "hero_time",
        "op": "<=",
        "value": 80
      }
    ],
    "verifier_id": "drill",
    "depends_on": [
      "finish"
    ]
  },
  {
    "id": "replay",
    "type": "save_wc3_replay",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  },
  {
    "id": "recording",
    "type": "save_rts_recording",
    "env_id": "wc3",
    "depends_on": [
      "grade"
    ]
  }
]
